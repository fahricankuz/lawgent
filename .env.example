# --- Veritabanı ---
# Migrasyon ve seed için tablo sahibi rol (yalnızca geliştirici/CI)
DATABASE_OWNER_URL=postgres://lawgent_owner:lawgent_owner@localhost:5432/lawgent
# Uygulamanın kullandığı rol: RLS'e tabidir, BYPASSRLS yoktur
DATABASE_URL=postgres://lawgent_app:lawgent_app@localhost:5432/lawgent
# Yalnızca oturum açma/doğrulama fonksiyonlarını çağırabilen rol
DATABASE_AUTH_URL=postgres://lawgent_auth:lawgent_auth@localhost:5432/lawgent
# Worker rolü (yükleme hattı)
DATABASE_WORKER_URL=postgres://lawgent_worker:lawgent_worker@localhost:5432/lawgent

# --- Belge deposu (MinIO, S3 uyumlu) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=tr-ist-1
S3_ACCESS_KEY=lawgent
S3_SECRET_KEY=lawgent-dev-secret
S3_BUCKET=lawgent-documents

# --- Şifreleme ---
# Büro anahtarlarını şifreleyen ana anahtar (32 bayt, base64). Üretimde Vault Transit kullanılır.
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=

# --- AI ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_URL=http://localhost:8001
EMBEDDING_DIM=1024

# --- Uygulama ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
SESSION_TTL_HOURS=12

# Geliştirmede MinIO yerine yerel disk kullanılabilir (mutlak yol önerilir)
# STORAGE_DRIVER=fs
# STORAGE_FS_ROOT=/mutlak/yol/lawgent/.data/objects
STORAGE_DRIVER=s3
# Dil modeli: none (ilgili bölümleri kaynaklarıyla listeler) | openai-compatible (Ollama/vLLM çalışıyorsa)
LLM_PROVIDER=none
# Worker embedding: none | bge-m3
EMBEDDING_PROVIDER=none
REQUIRE_MFA=false
